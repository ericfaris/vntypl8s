{
  "name": "@vntypl8s/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:cards": "tsx src/scripts/generate-cards.ts",
    "bots": "tsx src/scripts/bots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@vntypl8s/shared": "*",
    "dotenv": "^18.0.0",
    "express": "^5.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
